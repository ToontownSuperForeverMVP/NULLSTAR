{
	"schemaVersion": 1,
	"id": "nullstar",
	"version": "${version}",
	"name": "NULLSTAR",
	"description": "Server-authoritative orbital weapons, bounded terrain deformation, and cinematic foundations for Minecraft 26.3.",
	"authors": [
		"NULLSTAR contributors"
	],
	"license": "CC0-1.0",
	"icon": "assets/nullstar/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.nullstar.Nullstar"],
		"client": ["com.nullstar.client.NullstarClient"]
	},
	"mixins": [
		{
			"config": "nullstar.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "=26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
